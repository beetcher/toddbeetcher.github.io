              "show_if": "address"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": "If this was on your calendar, the attached calendar file removes it."
        },
        {
          "type": "paragraph",
          "text": "Questions? Just reply to this email."
        },
        {
          "type": "paragraph",
          "text": "Launch"
        }
      ]
    },
