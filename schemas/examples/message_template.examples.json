            {
              "label": "Where",
              "value": "{where}",
              "show_if": "where"
            },
            {
              "label": "Address",
              "value": "{address}",
              "show_if": "address"
            },
            {
              "label": "Lead instructor",
              "value": "{lead}",
              "show_if": "lead"
            },
            {
              "label": "Also teaching",
              "value": "{also_teaching}",
              "show_if": "also_teaching"
            },
            {
              "label": "Good to know",
              "value": "{notes}",
              "show_if": "notes"
            },
            {
              "label": "Confirmation number",
              "value": "{confirmation_number}",
              "show_if": "confirmation_number"
            }
          ]
        },
        {
          "type": "button",
          "show_if": "map_url",
          "label": "Open the map",
          "link": "{map_url}",
          "plain_prefix": "Map:"
        },
        {
          "type": "paragraph",
          "text": "A calendar file is attached: open it to add this to your calendar."
        },
        {
          "type": "paragraph",
          "text": "Need to change something? Just reply to this email."
        },
        {
          "type": "paragraph",
          "text": "Launch"
        }
      ]
    },
