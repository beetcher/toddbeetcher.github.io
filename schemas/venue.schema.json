{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetcher.com/schemas/venue.schema.json",
  "title": "venue",
  "description": "A place where classes are held. A scheduled_class points at one venue by venue_id and names a room by venue_room_label. A venue holds where it is, how to get in, who to contact, its rooms (inside the record), accessibility, house rules, hours and what it costs. Reviews are their own records that point at the venue; only review_count and average_rating live here. Precise spots inside a venue are location_pin records, a later schema, listed by location_pin_ids. Fields marked readOnly are set by the server only. Endpoint rules the schema cannot express: room labels are unique within the venue, a room preferred_occupancy is not above its max_occupancy, opens_at is before closes_at.",
  "type": "object",
  "additionalProperties": false,
  "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]*$"
  },
  "x_retention": "undecided",
  "required": [
    "name",
    "slug",
    "status",
    "is_public_venue"
  ],
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "status": {
      "enum": [
        "active",
        "inactive"
      ]
    },
    "is_public_venue": {
      "type": "boolean"
    },
    "street_address": {
      "type": "string",
      "maxLength": 200,
      "x_pii": true
    },
    "address_line_2": {
      "type": "string",
      "maxLength": 200,
      "x_pii": true
    },
    "city": {
      "type": "string",
      "maxLength": 100
    },
    "state_region": {
      "type": "string",
      "maxLength": 100
    },
    "postal_code": {
      "type": "string",
      "maxLength": 20
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "time_zone": {
      "type": "string",
      "maxLength": 64
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "parking_description": {
      "type": "string",
      "maxLength": 1000
    },
    "parking_latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "parking_longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "entry_description": {
      "type": "string",
      "maxLength": 1000
    },
    "entry_latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "entry_longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "transit_description": {
      "type": "string",
      "maxLength": 1000
    },
    "location_pin_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true,
      "maxItems": 50
    },
    "contact_name": {
      "type": "string",
      "maxLength": 200,
      "x_pii": true
    },
    "contact_email": {
      "type": "string",
      "maxLength": 200,
      "format": "email",
      "x_pii": true
    },
    "contact_phone": {
      "type": "string",
      "maxLength": 40,
      "x_pii": true
    },
    "backup_contact_name": {
      "type": "string",
      "maxLength": 200,
      "x_pii": true
    },
    "backup_contact_email": {
      "type": "string",
      "maxLength": 200,
      "format": "email",
      "x_pii": true
    },
    "backup_contact_phone": {
      "type": "string",
      "maxLength": 40,
      "x_pii": true
    },
    "website_url": {
      "type": "string",
      "maxLength": 300,
      "format": "uri"
    },
    "booking_process": {
      "type": "string",
      "maxLength": 1000
    },
    "booking_lead_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 730
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "max_occupancy"
        ],
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "preferred_occupancy": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "max_occupancy": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "is_accessible": {
            "type": "boolean"
          },
          "seating_layout": {
            "type": "string",
            "maxLength": 200
          },
          "equipment": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100,
              "minLength": 1
            },
            "maxItems": 30
          },
          "notes": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "maxItems": 100
    },
    "has_wifi": {
      "type": "boolean"
    },
    "wifi_notes": {
      "type": "string",
      "maxLength": 500
    },
    "is_accessible": {
      "type": "boolean"
    },
    "has_step_free_entry": {
      "type": "boolean"
    },
    "has_elevator": {
      "type": "boolean"
    },
    "has_accessible_restroom": {
      "type": "boolean"
    },
    "accessibility_notes": {
      "type": "string",
      "maxLength": 1000
    },
    "allows_minors": {
      "type": "boolean"
    },
    "allows_animals": {
      "type": "boolean"
    },
    "allows_food": {
      "type": "boolean"
    },
    "allows_alcohol": {
      "type": "boolean"
    },
    "requires_insurance": {
      "type": "boolean"
    },
    "insurance_notes": {
      "type": "string",
      "maxLength": 500
    },
    "availability_hours": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "day_of_week",
          "opens_at",
          "closes_at"
        ],
        "properties": {
          "day_of_week": {
            "enum": [
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday"
            ]
          },
          "opens_at": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "closes_at": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          }
        }
      },
      "maxItems": 14
    },
    "availability_notes": {
      "type": "string",
      "maxLength": 1000
    },
    "setup_minutes_before": {
      "type": "integer",
      "minimum": 0,
      "maximum": 480
    },
    "teardown_minutes_after": {
      "type": "integer",
      "minimum": 0,
      "maximum": 480
    },
    "cost_cents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "cost_basis": {
      "enum": [
        "per_hour",
        "per_session",
        "per_day"
      ]
    },
    "deposit_cents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "cancellation_terms": {
      "type": "string",
      "maxLength": 1000
    },
    "cost_notes": {
      "type": "string",
      "maxLength": 500
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "schema_version": {
      "const": 1,
      "readOnly": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "created_by": {
      "type": "string",
      "maxLength": 100,
      "readOnly": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "updated_by": {
      "type": "string",
      "maxLength": 100,
      "readOnly": true
    },
    "source": {
      "enum": [
        "dashboard",
        "import"
      ],
      "readOnly": true
    },
    "previous_id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "deleted_by": {
      "type": "string",
      "maxLength": 100,
      "readOnly": true
    },
    "review_count": {
      "type": "integer",
      "minimum": 0,
      "readOnly": true
    },
    "average_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "readOnly": true
    }
  },
  "x_server_required": [
    "id",
    "schema_version",
    "created_at",
    "created_by",
    "updated_at",
    "updated_by",
    "source",
    "review_count"
  ],
  "dependentRequired": {
    "latitude": [
      "longitude"
    ],
    "longitude": [
      "latitude"
    ],
    "parking_latitude": [
      "parking_longitude"
    ],
    "parking_longitude": [
      "parking_latitude"
    ],
    "entry_latitude": [
      "entry_longitude"
    ],
    "entry_longitude": [
      "entry_latitude"
    ],
    "cost_cents": [
      "cost_basis"
    ],
    "cost_basis": [
      "cost_cents"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "street_address",
          "city",
          "state_region",
          "postal_code",
          "country",
          "time_zone",
          "contact_name",
          "rooms",
          "is_accessible",
          "allows_minors",
          "allows_animals"
        ],
        "properties": {
          "rooms": {
            "minItems": 1
          }
        },
        "anyOf": [
          {
            "required": [
              "contact_email"
            ]
          },
          {
            "required": [
              "contact_phone"
            ]
          }
        ]
      }
    }
  ]
}
