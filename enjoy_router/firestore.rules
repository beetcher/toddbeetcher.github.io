rules_version = '2';
// Browsers may not read or write anything here. The endpoint writes with admin access, which bypasses rules.
// This file is for the dedicated enjoy project only. Never deploy it to a project another codebase shares:
// a rules deploy replaces the whole file.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
