{
  "functions": [
    {
      "source": ".",
      "codebase": "enjoy",
      "runtime": "python312",
      "ignore": [
        "venv",
        ".git",
        "__pycache__",
        "*.local",
        "README.md",
        "run_tests.py",
        "run_http_tests.py",
        "run_console_tests.py",
        "run_crud_tests.py",
        "run_crud_endpoint_tests.py",
        "run_class_tests.py",
        "run_assignment_tests.py",
        "admin_curl_check.sh",
        "crud_curl_demo.sh",
        "firebase-debug.log",
        "firestore-debug.log",
        "ui-debug.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "functions": {
      "port": 5101
    },
    "firestore": {
      "port": 8180
    },
    "ui": {
      "enabled": true,
      "port": 4100
    },
    "singleProjectMode": true
  }
}
